# LLM provider. "ollama" uses a local OpenAI-compatible server.
# "groq" and "openai" use the same client with a different base URL + key.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
DEFAULT_MODEL=qwen2.5:7b
LLM_API_KEY=ollama

# Optional hosted fallbacks (leave blank to stay local).
# GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ICP routing thresholds (0-100).
QUALIFY_THRESHOLD=75
NURTURE_THRESHOLD=50

# Public-page fetch settings. This tool only reads public homepages.
SCRAPE_TIMEOUT_SECONDS=12
SCRAPE_MAX_BYTES=400000
# Hosts resolving to loopback/private/link-local/reserved IPs are refused (SSRF guard).
# Set true only for local development against your own network.
SCRAPE_ALLOW_PRIVATE_HOSTS=false
USER_AGENT=LeadQualificationAgent/1.0 (+https://github.com/lupenox/lead-qualification-agent)

# Optional enrichment. Tavily is used only when a key is present.
# TAVILY_API_KEY=

# Slack is optional. Without a webhook the agent still persists results.
# SLACK_WEBHOOK_URL=

# Persistence
DATABASE_PATH=data/leads.db

# API
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
